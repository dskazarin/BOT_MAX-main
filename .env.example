# ============================================================
# BOT_MAX — шаблон переменных окружения
# B10.5 · 2026-09-25
#
# Скопируйте в .env и заполните:
#   cp .env.example .env
#
# .env НЕ коммитится (см. .gitignore / .dockerignore).
# ============================================================

# ---------- Окружение ----------
# BOTMAX_ENV: dev | prod (пусто = dev)
#   dev  — дефолтный JWT-секрет, cookie без Secure
#   prod — обязателен BOTMAX_JWT_SECRET (>=32 байт), cookie с Secure
BOTMAX_ENV=dev

# ---------- JWT ----------
# Секрет подписи JWT (HS256). В prod ОБЯЗАТЕЛЕН, >= 32 байт.
# Сгенерировать:  head -c 48 /dev/urandom | base64
BOTMAX_JWT_SECRET=

# ---------- Auth ----------
# Enforce-режим: без валидного токена 401 (иначе — soft-mode).
# 1|true|yes|on   → enforce=true
# 0|false|no|off  → soft-mode
# пусто           → false
BOTMAX_AUTH_ENFORCE=true

# ---------- Cookie ----------
# Secure-флаг на auth-cookie (HttpOnly + SameSite=Strict всегда).
# пусто → auto: prod=true, dev=false
# 1|true|yes|on   → Secure=true (нужен HTTPS)
# 0|false|no|off  → Secure=false (работает на http://localhost)
BOTMAX_COOKIE_SECURE=

# ---------- БД ----------
# Путь к SQLite-файлу. Пусто → rootDir/bot_max.db.
# В Docker монтируется в /data (см. docker-compose.yml).
BOTMAX_DB_PATH=

# URL Postgres (для будущей миграции B12).
# BOTMAX_DB_URL=postgres://botmax:changeme@postgres:5432/botmax?sslmode=disable

# ---------- Хранилище файлов (B30.10 §6.59) ----------
# KIND: blob | fs | s3 (s3 — зарезервировано, пока не реализовано)
#   blob — files.data BLOB в SQLite (текущее поведение по умолчанию)
#   fs   — файлы на диске, в БД только storage_kind/storage_key
BOTMAX_STORAGE_KIND=blob
# DIR: базовый каталог для kind=fs. Пусто → <каталог БД>/storage.
BOTMAX_STORAGE_DIR=
# MAX_MIB: максимальный размер файла в МиБ. Пусто → 6.
BOTMAX_STORAGE_MAX_MIB=
# MIGRATE: 1 — при старте перенести BLOB → FS (только для kind=fs).
BOTMAX_STORAGE_MIGRATE=
BOTMAX_STORAGE_GC_DAYS=30

# B30.14: S3-совместимое хранилище (kind=s3).
# Включается через BOTMAX_STORAGE_KIND=s3.
# PRESIGN=true — GET /api/files/{id}/url возвращает presigned URL.
# PRESIGN=false — эндпоинт отвечает 501 (используйте /api/patient/records/files/{id}/data).
# BOTMAX_STORAGE_S3_ENDPOINT=minio:9000
# BOTMAX_STORAGE_S3_BUCKET=botmax-files
# BOTMAX_STORAGE_S3_ACCESS_KEY=minioadmin
# BOTMAX_STORAGE_S3_SECRET_KEY=minioadmin
# BOTMAX_STORAGE_S3_REGION=us-east-1
# BOTMAX_STORAGE_S3_USE_SSL=false
# BOTMAX_STORAGE_S3_PRESIGN=true
# BOTMAX_STORAGE_S3_PRESIGN_TTL=15m
