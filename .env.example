# ============================================================
# BOT_MAX — шаблон переменных окружения
# B10.5 · 2026-09-25
#
# Скопируйте в .env и заполните:
#   cp .env.example .env
#
# .env НЕ коммитится (см. .gitignore / .dockerignore).
# ============================================================

# ---------- Окружение ----------
# BOTMAX_ENV: dev | prod (пусто = dev)
#   dev  — дефолтный JWT-секрет, cookie без Secure
#   prod — обязателен BOTMAX_JWT_SECRET (>=32 байт), cookie с Secure
BOTMAX_ENV=dev

# ---------- JWT ----------
# Секрет подписи JWT (HS256). В prod ОБЯЗАТЕЛЕН, >= 32 байт.
# Сгенерировать:  head -c 48 /dev/urandom | base64
BOTMAX_JWT_SECRET=

# ---------- Auth ----------
# Enforce-режим: без валидного токена 401 (иначе — soft-mode).
# 1|true|yes|on   → enforce=true
# 0|false|no|off  → soft-mode
# пусто           → false
BOTMAX_AUTH_ENFORCE=true

# ---------- Cookie ----------
# Secure-флаг на auth-cookie (HttpOnly + SameSite=Strict всегда).
# пусто → auto: prod=true, dev=false
# 1|true|yes|on   → Secure=true (нужен HTTPS)
# 0|false|no|off  → Secure=false (работает на http://localhost)
BOTMAX_COOKIE_SECURE=

# ---------- БД ----------
# Путь к SQLite-файлу. Пусто → rootDir/bot_max.db.
# В Docker монтируется в /data (см. docker-compose.yml).
BOTMAX_DB_PATH=

# URL Postgres (для будущей миграции B12).
# BOTMAX_DB_URL=postgres://botmax:changeme@postgres:5432/botmax?sslmode=disable
