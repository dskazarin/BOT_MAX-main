# ============================================================
# BOT_MAX — .dockerignore
# B10.2 · 2026-09-25
#
# Что НЕ попадает в docker build context.
# ============================================================

# ---------- Git / CI ----------
.git/
.github/
.gitignore

# ---------- Документация и метаданные ----------
*.md
LICENSE
SNAPSHOTS.md

# ---------- Docker-файлы (не нужны в контексте) ----------
Dockerfile
.dockerignore
docker-compose.yml

# ---------- Env ----------
.env
.env.*

# ---------- Бэкапы ----------
*.bak
*.bak.*
*.orig
*.rej

# ---------- SQLite (в контейнере БД создаётся заново) ----------
*.db
*.db-shm
*.db-wal

# ---------- Логи ----------
*.log
logs/

# ---------- Go-тесты (не нужны в runtime) ----------
**/*_test.go

# ---------- IDE / редакторы ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
